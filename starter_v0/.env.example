# Day 03 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; OpenRouter recommended) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Local small model (bonus challenge, no key needed) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# OLLAMA_CALL_MODE=native
# OLLAMA_REASONING_EFFORT=none
# OLLAMA_PROTOCOL_RETRIES=1
# OLLAMA_PROTOCOL_RETRY_FORMAT=structured_plan
# ARTIFACT_VERSION=v12-local
# Set OLLAMA_PROTOCOL_RETRIES=0 for a native-only comparison.
# A retry occurs only for missing required calls or a completely empty auto response.
# It uses the full tool schema; the model still chooses every tool and argument.
# DEFAULT_PROVIDER=ollama
# Use DEFAULT_PROVIDER=demo (offline) for an entirely local scripted demo.

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day03-Research-Agent/1.0 (educational lab)

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
